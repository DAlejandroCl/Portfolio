---
import { Image } from 'astro:assets';
import { responsiveImage } from '../../lib/responsiveImage';
import { getCollection, getEntry } from 'astro:content';
import { resolveMetrics } from '../../content/evidence';
import type { Locale } from '../../i18n/config';
import { profile } from '../../data/profile';
import { personJsonLd, scholarlyArticleJsonLd } from '../../seo/structuredData';
import { getDictionary, localizedPath } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MarginNote } from '../shared/MarginNote';
import { Button } from '../ui/Button';
import { AboutSection } from './AboutSection';
import { ContactSection } from './ContactSection';
import { ExpertiseSection } from './ExpertiseSection';
import { FocusSection } from './FocusSection';
import { Hero } from './Hero';
import { CertificationsSection } from './CertificationsSection';
import { ExperienceSection } from './ExperienceSection';
import { ProjectsSection, type ProjectItem } from './ProjectsSection';
import { PublicationSection } from './PublicationSection';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const entries = (await getCollection('projects', ({ data }) => data.lang === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
const hero = entries.find((entry) => entry.id === `${locale}/cocktail-lab`);
if (!hero) {
  throw new Error(`Missing Cocktail Lab content for locale "${locale}".`);
}
const coverage = resolveMetrics(hero.data)[0];
if (!coverage) {
  throw new Error('The hero expects the Cocktail Lab coverage metric.');
}

const projects: ProjectItem[] = await Promise.all(
  entries.map(async (entry) => ({
    slug: entry.id.split('/')[1] ?? entry.id,
    title: entry.data.title,
    summary: entry.data.summary,
    status: entry.data.status,
    stack: entry.data.stack,
    repo: entry.data.links.repo,
    demo: entry.data.links.demo,
    image: {
      ...(await responsiveImage(entry.data.screenshot, [480, 640, 960, 1280])),
      alt: entry.data.screenshotAlt,
    },
  })),
);

const publication = await getEntry('publications', `${locale}/ieee-2025`);
if (!publication) {
  throw new Error(`Missing publication content for locale "${locale}".`);
}

const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = [
  personJsonLd(locale, site),
  scholarlyArticleJsonLd(
    {
      title: publication.data.title,
      titleLang: publication.data.titleLang,
      venue: publication.data.venue,
      year: publication.data.year,
      url: publication.data.evidence.source.url,
    },
    site,
  ),
];
---

<BaseLayout title={t.meta.homeTitle} description={t.meta.homeDescription} jsonLd={jsonLd}>
  <Hero
    firstNames={t.site.firstNames}
    lastNames={t.site.lastNames}
    jobTitle={t.site.role}
    statement={t.hero.statement}
    stack={{ label: t.hero.stackLabel, items: profile.heroStack }}
  >
    <Fragment slot="actions">
      <Button href={profile.links.email} variant="field">
        {t.hero.contact}
      </Button>
      <Button href={`${localizedPath(locale, '/')}#projects`} variant="field-outline">
        {t.hero.viewProjects}
      </Button>
      <Button href={profile.cv[locale]} variant="field-outline">
        {t.hero.downloadCv}
      </Button>
    </Fragment>
    <figure class="relative">
      <div class="overflow-hidden rounded-media bg-surface ring-1 ring-white/30 lg:-mr-12 lg:rounded-r-none">
        <Image
          src={hero.data.screenshot}
          alt={hero.data.screenshotAlt}
          widths={[480, 640, 960, 1280]}
          sizes="(min-width: 64rem) 32rem, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[5/4] w-full object-cover"
        />
      </div>
      <figcaption class="mt-4 space-y-3 lg:absolute lg:-bottom-6 lg:-left-10 lg:mt-0 lg:max-w-xs">
        <div class="mark rounded-media bg-mark px-4 py-3 text-on-mark">
          <p class="font-display text-h3">
            {coverage.label}: {coverage.value}
          </p>
          <MarginNote evidence={coverage.evidence} locale={locale} labels={t.note} variant="bare" />
        </div>
      </figcaption>
    </figure>
  </Hero>
  <AboutSection labels={t.about}>
    <FocusSection labels={t.focus} locale={locale} />
  </AboutSection>
  <ProjectsSection
    projects={projects}
    locale={locale}
    labels={{ projects: t.projects, caseStudy: t.caseStudy, status: t.status }}
  />
  <ExperienceSection labels={t.experience} locale={locale} />
  <PublicationSection
    publication={publication.data}
    locale={locale}
    labels={{ publication: t.publication, note: t.note }}
  />
  <CertificationsSection labels={t.certifications} locale={locale} />
  <ExpertiseSection labels={t.expertise} />
  <ContactSection labels={t.contact} cvHref={profile.cv[locale]} />
</BaseLayout>
