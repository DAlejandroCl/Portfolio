---
import { Button } from '../components/ui/Button';
import { en } from '../i18n/dictionaries/en';
import { es } from '../i18n/dictionaries/es';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`${en.notFound.metaTitle} | ${en.site.firstNames} ${en.site.lastNames}`}
  description={en.notFound.text}
  noindex
>
  <section class="py-16 md:py-24">
    <h1 class="text-h1">{en.notFound.title}</h1>
    <p class="mt-6 max-w-[60ch] text-lede">{en.notFound.text}</p>
    <p class="mt-8">
      <Button href="/">{en.notFound.home}</Button>
    </p>
    <div lang="es" class="mt-16 border-t border-line-strong pt-8">
      <h2 class="text-h2">{es.notFound.title}</h2>
      <p class="mt-4 max-w-[60ch]">{es.notFound.text}</p>
      <p class="mt-6">
        <Button href="/es/">{es.notFound.home}</Button>
      </p>
    </div>
  </section>
</BaseLayout>
